
/// \file version_config.hpp.cmake.in
/// Contains definitions of version components

#ifndef CXXDBG_CORE_VERSION_CONFIG_HPP
#define CXXDBG_CORE_VERSION_CONFIG_HPP


#define CXXDBG_VERSION_MAJOR      @CXXDBG_VERSION_MAJOR@
#define CXXDBG_VERSION_MINOR      @CXXDBG_VERSION_MINOR@
#define CXXDBG_VERSION_PATCHLEVEL @CXXDBG_VERSION_PATCHLEVEL@
#define CXXDBG_VERSION_IS_RELEASE @CXXDBG_VERSION_IS_RELEASE@

#define CXXDBG_VERSION_MAJOR_STR      "@CXXDBG_VERSION_MAJOR@"
#define CXXDBG_VERSION_MINOR_STR      "@CXXDBG_VERSION_MINOR@"
#define CXXDBG_VERSION_PATCHLEVEL_STR "@CXXDBG_VERSION_PATCHLEVEL@"
#define CXXDBG_VERSION_NAME           "@CXXDBG_VERSION_NAME@"


#endif // CXXDBG_CORE_VERSION_CONFIG_HPP
